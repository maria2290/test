<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.leidy.controller.UsuarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>


    <VBox prefWidth="300.0" spacing="10.0">
        <TextField fx:id="txtNombre" promptText="Nombre" />
        <TextField fx:id="txtCorreo" promptText="Correo" />
        <PasswordField fx:id="txtcontrasena" promptText="Contraseña" />
        <TextField fx:id="txtDireccion" promptText="Dirección" />
    </VBox>


    <HBox alignment="CENTER" spacing="10.0">
        <Button onAction="#onUsuarioButtonClick" text="Crear Usuario" textFill="#570898" />
        <Button onAction="#handleActualizarUsuario" text="Actualizar" textFill="#3905b3" />
        <Button fx:id="btnEliminar" onAction="#handleEliminarUsuario" text="Eliminar" textFill="#4707be" />
    </HBox>


    <TableView fx:id="tableUsuario" onMouseClicked="#handleSeleccionar" prefHeight="200.0" prefWidth="350.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="90.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
            <TableColumn fx:id="colCorreo" prefWidth="135.0" text="Correo" />
        </columns>
    </TableView>


    <Label fx:id="lblMensaje" text="Bienvenida" textFill="#d270a1" />
</VBox>
